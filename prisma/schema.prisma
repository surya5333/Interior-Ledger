generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  email     String?
  createdAt DateTime  @default(now()) @map("created_at")
  projects  Project[]

  @@index([name])
}

model Project {
  id           String        @id @default(cuid())
  name         String
  location     String?
  clientId     String        @map("client_id")
  budget       Decimal       @db.Decimal(12, 2)
  status       ProjectStatus @default(ACTIVE)
  scheduledDate DateTime?    @map("scheduled_date")
  notes        String?
  createdAt    DateTime      @default(now()) @map("created_at")
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@index([clientId])
  @@index([createdAt])
}

enum ProjectStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

model Contact {
  id           String        @id @default(cuid())
  name         String
  category     String
  phone        String?
  createdAt    DateTime      @default(now()) @map("created_at")
  transactions Transaction[]

  @@unique([name, category])
  @@index([name])
}

enum PaymentMode {
  CASH
  UPI
  CARD
  OTHER
}

model Transaction {
  id              String      @id @default(cuid())
  projectId       String      @map("project_id")
  contactId       String?     @map("contact_id")
  isClientPayment Boolean     @default(false) @map("is_client_payment")
  category        String
  description     String?
  date            DateTime
  credit          Decimal     @default(0) @db.Decimal(12, 2)
  debit           Decimal     @default(0) @db.Decimal(12, 2)
  paymentMode     PaymentMode @default(CASH)
  paymentProofUrl String?     @map("payment_proof_url")
  createdAt       DateTime    @default(now()) @map("created_at")
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contact         Contact?    @relation(fields: [contactId], references: [id], onDelete: Restrict)

  @@index([projectId, date, createdAt])
  @@index([contactId, date])
  @@index([isClientPayment, projectId])
}

model Settings {
  id           String  @id @default("singleton")
  companyName  String  @map("company_name")
  logoUrl      String? @map("logo_url")
  signatureUrl String? @map("signature_url")
}

enum Role {
  ADMIN
  MANAGER
}

model User {
  id           String    @id @default(cuid())
  name         String
  username     String    @unique
  passwordHash String    @map("password_hash")
  role         Role      @default(MANAGER)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  sessions     Session[]

  @@index([username])
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
}
