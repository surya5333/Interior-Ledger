# Serverless runtime: Supabase transaction-pooler URL (port 6543).
DATABASE_URL="postgresql://prisma.[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres"
# Prisma CLI migrations only: Supabase direct URL (port 5432) or session pooler.
DIRECT_URL="postgresql://prisma:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
